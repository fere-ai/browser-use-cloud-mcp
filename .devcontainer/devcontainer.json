{
    "name": "Browser Use Cloud MCP",
    "dockerFile": "Dockerfile",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.10"
        },
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.isort",
                "charliermarsh.ruff",
                "ms-python.mypy-type-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/python/latest/bin/python",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,
                "python.linting.mypyEnabled": true,
                "python.formatting.provider": "black",
                "python.formatting.blackArgs": ["--line-length", "88"],
                "python.sortImports.args": ["--profile", "black"],
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": true
                }
            }
        }
    },
    "postCreateCommand": "pip install poetry && poetry install",
    "remoteUser": "vscode",
    "mounts": [
        "source=${localWorkspaceFolder}/.git,target=/workspaces/browser-use-cloud-mcp/.git,type=bind,consistency=cached"
    ]
}